# Writes corpus.toml: N [[package]] entries in the shape of a Cargo.lock,
# plus a [meta] table and one table of every value type per 100 packages.
# Every value is computed from the entry number, so the file is reproducible
# byte for byte and contains nobody's data.
#
#   raku gen.raku 10000     # ~1.9 MB
#   raku gen.raku 1000

my $n = (@*ARGS[0] // 1000).Int;
my @out;
@out.push: "# generated by benchmarks/toml/gen.raku $n — synthetic, reproducible\n";
@out.push: "version = 3\n\n[meta]\ngenerated = 2026-09-23T10:00:00Z\ncount = $n\n";
my @cities = <Sevilla Zürich København Kraków Reykjavík Tōkyō>;
for ^$n -> $i {
    my $name = "crate-{$i.base(36).lc}";
    @out.push: "\n[[package]]\n";
    @out.push: "name = \"$name\"\n";
    @out.push: "version = \"{$i % 7}.{$i % 13}.{$i % 29}\"\n";
    @out.push: "source = \"registry+https://example.invalid/index\"\n";
    @out.push: "checksum = \"{ sprintf('%064x', ($i * 2654435761) % 2**64) }\"\n";
    if $i %% 3 {
        @out.push: "dependencies = [\n" ~ (1..($i % 5 + 1)).map({ "    \"crate-{(($i + $_) % $n).base(36).lc}\",\n" }).join ~ "]\n";
    }
    if $i %% 100 {
        @out.push: "\n[package.details]\n";
        @out.push: "city = '{@cities[$i % @cities]}'\n";
        @out.push: "ratio = {($i % 97) / 8}e0\n";
        @out.push: "big = 0x{($i * 7919).base(16).lc}\n";
        @out.push: "flags = \{ yanked = {$i %% 200 ?? 'true' !! 'false'}, weight = {$i + 1}_000 }\n";
        @out.push: "released = 2020-{sprintf('%02d', $i % 12 + 1)}-{sprintf('%02d', $i % 28 + 1)}\n";
        @out.push: "notes = \"\"\"\nline one of {$i}\nline \\\"two\\\"\\tend\"\"\"\n";
    }
}
"corpus.toml".IO.spurt(@out.join);
say "corpus.toml: $n packages, {'corpus.toml'.IO.s} bytes";
