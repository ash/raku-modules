# Частотний словник: клас з атрибутом і методами, геш, регулярний
# вираз, сортування та іменований аргумент — усе українською.
#
#     RAKUDO_RAKUAST=1 rakudo -I lib examples/wordcount.raku   # Rakudo
#
# Через `ukrku` цей файл не запуститься: виконавець підключає сленг до
# розбору, і тоді `use` у першому рядку довелося б писати як `використай`.

use L10N::UK;

мій $текст = q:to/ТЕКСТ/;
Раку — мова, що має багато облич. Одна й та сама мова
читається по-різному, і це не метафора: сленг змінює
граматику, а не лише словник. Мова лишається тією самою.
ТЕКСТ

клас Лічильник {
    має %.частоти;

    метод врахуй(Str:D $слово) {
        %!частоти{$слово}++ якщо $слово;
        сам
    }

    метод вершина(Int:D :$скільки = 5) {
        %!частоти.пари.сортуй({ -.значення, .ключ }).голова($скільки)
    }
}

мій $лічильник = Лічильник.новий;
для $текст.малі.вичеши(/<[\w\-]>+/) -> $слово {
    $лічильник.врахуй($слово);
}

для $лічильник.вершина(скільки => 5) -> $пара {
    кажи $пара.значення ~ "  " ~ $пара.ключ;
}
