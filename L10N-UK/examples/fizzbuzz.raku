# ФізБаз. Перший рядок — єдиний, який не можна написати українською:
# сленг ще не підключено, доки `use` не виконано.
#
#     RAKUDO_RAKUAST=1 rakudo -I lib examples/fizzbuzz.raku   # Rakudo
#     rakupp -I lib examples/fizzbuzz.raku                    # Raku++
#
# Через `ukrku` цей файл не запуститься: виконавець підключає сленг до
# розбору, і тоді `use` у першому рядку довелося б писати як `використай`.

use L10N::UK;

для 1..20 -> $ч {
    дано $ч {
        коли $_ %% 15 { кажи "ФізБаз" }
        коли $_ %% 3  { кажи "Фіз"    }
        коли $_ %% 5  { кажи "Баз"    }
        замовчування  { кажи $ч       }
    }
}
