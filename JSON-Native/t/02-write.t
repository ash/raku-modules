my @impls = 'JSON::Native'       => &to-json,
            'JSON::Native::Raku' => &JSON::Native::Raku::to-json;

diag "json-backend: {json-backend}";

enum Blerp <Hello Goodbye>;

plan @impls * 12 + 4;

for @impls -> (:key($name), :value(&write)) {
    subtest "$name: writes what JSON::Fast writes", {
        plan +@write;
        for @write -> (&value, %opt, $label, $want) {
            is write(value(), |%opt), $want, $label;
        }
    }

    is write([Hello, Goodbye], :!pretty), '["Hello","Goodbye"]', "$name: an enum is its name";
    is write([Hello, Goodbye], :!pretty, :enums-as-value), '[0,1]', "$name: ... or its value, under :enums-as-value";
    is write({b => 1, a => 2, c => 3}, :sorted-keys(*.value), :!pretty), '{"b":1,"a":2,"c":3}',
       "$name: :sorted-keys takes a sort key, as .sort does";

    # NaN/Inf hang on a DYNAMIC: "null" by default (in the table above), the
    # bare token under $*JSON_NAN_INF_SUPPORT.
    {
        my $*JSON_NAN_INF_SUPPORT = True;
        is write([NaN, Inf, -Inf], :!pretty), '[NaN,Inf,-Inf]', "$name: honours \$*JSON_NAN_INF_SUPPORT";
    }

    # Where JSON::Fast refuses, the answer has to be a refusal too — a
    # serialiser that quietly invented an encoding would be the worse bug.
    throws-like { write(1+2i) }, Exception, message => /'Complex'/, "$name: a Complex is refused";
    dies-ok { write(Mu) }, "$name: Mu is refused, as JSON::Fast's Any-typed parameter refuses it";
    dies-ok { write(1, :frobnicate) }, "$name: an unknown adverb is refused";

    # An Array argument must not flatten on its way in — `to-json([1,2,3])`
    # once gave `1` under Raku++, while JSON::Native's sub was declared `(|c)`.
    is write([1, 2, 3], :!pretty), '[1,2,3]', "$name: an Array argument is one argument";

    # A hash wide enough that a per-key walk costing O(i) would be quadratic.
    {
        my %wide;
        %wide{"key-{$_.fmt('%05d')}"} = $_ for ^5000;
        is write(%wide, :!pretty, :sorted-keys),
           '{' ~ (^5000).map({ "\"key-{$_.fmt('%05d')}\":$_" }).join(',') ~ '}',
           "$name: a 5,000-key hash";
    }

    # Round trip, which is the property a user actually relies on. Compared as
    # DATA where a hash has more than one key, since then the text order is the
    # engine's business.
    subtest "$name: round trips", {
        plan 9;
        for '{"a":[1,2.5,true,null],"b":{"c":"d"}}', '{"z":1,"a":2}' -> $json {
            is-deeply from-json(write(from-json($json), :!pretty)), from-json($json), $json;
        }
        for '[]', '{}', '[[[]]]', '[1,2,3]', '{"only":1}', '"str"', '42' -> $json {
            is write(from-json($json), :!pretty), $json, "$json, byte for byte";
        }
    }

    # Every string escape there is, and every one there is not: what JSON::Fast
    # writes for each control character, the quote, the backslash and DEL.
    is write((0..0x1F, 0x22, 0x5C, 0x7F).flat.map(*.chr).join, :!pretty),
       '"' ~ (0..0x1F).map({ $_ == 9 ?? '\t' !! $_ == 10 ?? '\n' !! $_ == 13 ?? '\r' !! sprintf('\u%04x', $_) }).join
         ~ '\"\\\\' ~ "\x7F" ~ '"',
       "$name: the escape table";
}

# A Str-valued writer stays a writer: :pretty is the default, and it is
# JSON::Fast's layout, down to the empty-container quirk.
is to-json({a => []}), qq/\{\n  "a": [\n  ]\n}/, 'the default is pretty, and an empty array is "[\n  ]"';
is to-json([1], :spacing(4)), qq/[\n    1\n]/, ':spacing sets the indent';
is to-json([1], :level(1)), qq/[\n    1\n  ]/, ':level starts deeper';
is to-json(Any), 'null', 'an undefined value is null';

done-testing;
