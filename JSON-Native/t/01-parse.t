# Compared as .raku, which sees what eqv does not — an itemised Array is
# `$[...]` — with ONE spelling normalised on both sides: a Bool pair is
# written `:!f` in some .raku output and `:f(Bool::False)` in other, and which
# one differs between the two engines and even between Hash and Map on one.
# The same value either way.
sub norm(Str $raku) {
    $raku.subst(/':' (<[\w-]>+) '(Bool::True)'/, { ":$0" }, :g)
         .subst(/':' (<[\w-]>+) '(Bool::False)'/, { ":!$0" }, :g)
}

my @impls = 'JSON::Native'       => &from-json,
            'JSON::Native::Raku' => &JSON::Native::Raku::from-json;

diag "json-backend: {json-backend}";

plan @impls * 7 + 10;

for @impls -> (:key($name), :value(&parse)) {
    subtest "$name: values and types", {
        plan +@parse;
        for @parse -> (:key($json), :value($want)) {
            is norm(parse($json).raku), norm($want), $json.raku;
        }
    }
    subtest "$name: :immutable", {
        plan +@parse-immutable;
        for @parse-immutable -> (:key($json), :value($want)) {
            is norm(parse($json, :immutable).raku), norm($want), $json.raku;
        }
    }
    subtest "$name: :allow-jsonc", {
        plan @jsonc + @jsonc-dies;
        for @jsonc -> (:key($json), :value($want)) {
            is norm(parse($json, :allow-jsonc).raku), norm($want), $json.raku;
        }
        # JSON::Fast's own quirks included: a // comment that runs to the end
        # of the text, or a /* that never closes, after the document reads as
        # additional content
        for @jsonc-dies -> $json {
            dies-ok { parse($json, :allow-jsonc) }, "refuses {$json.raku}";
        }
    }
    subtest "$name: refusals", {
        plan +@dies;
        for @dies -> $json {
            dies-ok { parse($json) }, "refuses {$json.raku}";
        }
    }
    # An exponent form is a Num, and the Num is the one .Numeric makes of the
    # token — the nativecall backend has strtod make it, which is right only
    # while the two agree. They did on 60,000 forms when that was decided;
    # this keeps asking, so an engine on which they part fails here.
    subtest "$name: exponent forms are .Numeric's Num", {
        my @forms = (^2000).map(-> $i {
            my $mant = ($i * 7919 % 17) + 1;
            my $digits = (^$mant).map({ ($i * 31 + $_ * 17) % 10 }).join;
            my $dot = $i % ($mant + 1);
            ($i %% 3 ?? '-' !! '')
              ~ ($digits.substr(0, $dot) || '0')
              ~ ($dot < $mant ?? '.' ~ $digits.substr($dot) !! '')
              ~ <e E e+ e->[$i % 4] ~ ($i * 13 % 640 - 330).abs
        });
        @forms.append: <1e-324 2.4703282292062328e-324 4.9406564584124654e-324
                        2.2250738585072011e-308 1.7976931348623157e308 1.7976931348623159e308
                        9007199254740993e0 0.1e0 5e-324 123456789012345678901234567890e-10>;
        my @bad = @forms.grep(-> $f { my $got = parse("[$f]")[0]; !($got === $f.Numeric || $got.raku eq $f.Numeric.raku) });
        diag "  differs: {.raku}" for @bad.head(5);
        is +@bad, 0, "{+@forms} exponent forms";
    }
    throws-like { parse('[1,2] junk') }, X::JSON::Native::AdditionalContent,
                "$name: content after the document is X::JSON::Native::AdditionalContent",
                parsed-length => 5, rest-position => 6;
    # An adverb JSON::Fast does not know is refused as JSON::Fast refuses it,
    # not quietly ignored — from every backend, since the native ones hand
    # what they do not claim to the Raku implementation.
    dies-ok { parse('1', :frobnicate) }, "$name: an unknown adverb is refused";
}

# Raku numerics rather than doubles — the property that makes a Raku JSON
# parser worth having.
is from-json('1.5')<>.WHAT.gist,  '(Rat)', 'a decimal is a Rat';
is from-json('17')<>.WHAT.gist,   '(Int)', 'an integer is an Int';
is from-json('1e3')<>.WHAT.gist,  '(Num)', 'an exponent form is a Num';
ok from-json('[0.1,0.2]').sum == 0.3, 'Rat arithmetic is exact';

# :immutable gives the immutable shapes
ok from-json('{"a":1}', :immutable) ~~ Map,  ':immutable gives a Map';
ok from-json('[1,2]',  :immutable) ~~ List,  ':immutable gives a List';
nok from-json('{"a":1}', :immutable) ~~ Hash, '... and not a Hash';

# A raw CR in a string is legal to JSON::Fast (only TAB and LF are refused);
# the C extension refuses it, and so the Raku implementation answers instead
is from-json("\"a\rb\""), "a\rb", 'a raw CR inside a string is accepted, as JSON::Fast accepts it';

# Str() coercion, as JSON::Fast's signature has it
is-deeply from-json(42), 42, 'a non-Str argument is coerced to Str';

# A document of a few hundred kilobytes, so the parse is seen to be linear
# rather than assumed to be.
{
    # concatenated, not one qq// with \{ and {…} in it: mutsu 2026.07 cannot parse that
    my $doc = '[' ~ (^20000).map({ '{"id":' ~ $_ ~ ',"name":"user ' ~ $_ ~ ' é","score":' ~ ($_ / 4) ~ '}' }).join(',') ~ ']';
    my $got = from-json($doc);
    ok $got.elems == 20000 && $got[19999]<name> eq 'user 19999 é' && $got[3]<score> == 0.75,
       "a {($doc.chars / 1024).round} KB document parses";
}

done-testing;
