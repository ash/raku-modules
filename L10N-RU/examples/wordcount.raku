# Частотный словарь: класс с атрибутом и методами, хеш, регулярное
# выражение, сортировка и именованный аргумент — всё по-русски.
#
#     RAKUDO_RAKUAST=1 rakudo -I lib examples/wordcount.raku   # Rakudo
#
# Через `rusku` этот файл не запустится: исполнитель подключает слэнг до
# разбора, и тогда `use` в первой строке пришлось бы писать как `используй`.

use L10N::RU;

мой $текст = q:to/ТЕКСТ/;
Раку — язык, у которого много лиц. Один и тот же язык
читается по-разному, и это не метафора: слэнг меняет
грамматику, а не только словарь. Язык остаётся тем же.
ТЕКСТ

класс Счётчик {
    имеет %.частоты;

    метод учти(Str:D $слово) {
        %!частоты{$слово}++ если $слово;
        сам
    }

    метод верхушка(Int:D :$сколько = 5) {
        %!частоты.пары.сортируй({ -.значение, .ключ }).голова($сколько)
    }
}

мой $счётчик = Счётчик.новый;
для $текст.строчные.вычеши(/<[\w\-]>+/) -> $слово {
    $счётчик.учти($слово);
}

для $счётчик.верхушка(сколько => 5) -> $пара {
    скажи $пара.значение ~ "  " ~ $пара.ключ;
}
