# ФизБаз. Первая строка — единственная, которую нельзя написать по-русски:
# слэнг ещё не подключён, пока `use` не выполнен.
#
#     RAKUDO_RAKUAST=1 rakudo -I lib examples/fizzbuzz.raku   # Rakudo
#     rakupp -I lib examples/fizzbuzz.raku                    # Raku++
#
# Через `rusku` этот файл не запустится: исполнитель подключает слэнг до
# разбора, и тогда `use` в первой строке пришлось бы писать как `используй`.

use L10N::RU;

для 1..20 -> $н {
    дано $н {
        когда $_ %% 15 { скажи "ФизБаз" }
        когда $_ %% 3  { скажи "Физ"    }
        когда $_ %% 5  { скажи "Баз"    }
        умолчание      { скажи $н       }
    }
}
