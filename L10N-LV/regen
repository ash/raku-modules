#!/usr/bin/env rakudo

# Rebuild lib/ from the .l10n table. This is `update-localization` from the
# L10N distribution, plus the handling of `|`-separated synonyms that two
# engine bugs get in the way of. Run it with Rakudo — Raku++ cannot load L10N.
#
#     rakudo regen
#         tokens get the first spelling only — the default, because it is
#         what both engines parse today
#
#     rakudo regen --synonyms
#         tokens get the whole alternation: Rakudo then accepts every
#         spelling, Raku++ 3.28.0 matches none
#
# A translation may name several spellings,
#
#     scope-my  mans|mana|mani|manas
#
# meaning the slang accepts all of them and the deparser prints the first.
# For a sub name, named argument, trait or adverb, L10N builds that
# correctly: those become
# lookup tables and the splitting happens there. For a translation that
# becomes a GRAMMAR TOKEN, which is what scope-my is, it hands a Seq to
# RakuAST::Regex::Alternation.new, which takes slurpy positionals; the Seq
# lands as one malformed alternative and generation dies with "You cannot
# deparse a Seq instance". So the table is flattened to first spellings before
# the generator sees it, and --synonyms writes the alternations back in
# afterwards.
#
# When L10N passes |@parts.map(...) at that branch the flattening becomes
# unnecessary; when Raku++ matches an alternation inside a slang token,
# --synonyms becomes the default. When both, delete this script.

use L10N;

# The prefixes whose translations become a lookup table rather than a token.
# Those split on `|` themselves and need nothing from us either way.
my constant @tabulated = <
  core- named- trait-is- adverb-pc- adverb-q- adverb-rx- pragma- system-
>;

sub MAIN(
  Bool :$synonyms,    #= widen each token to every spelling its table names
) {
    my $extension := L10N.extension;
    my $io        := dir.first(*.extension eq $extension)
      // die "no .$extension translation table in $*CWD";

    # Every token translation that names more than one spelling.
    my %alternatives;
    for $io.lines -> $line {
        next if $line.starts-with("#");
        my ($key, $translation) = $line.words;
        next unless $translation && $translation.contains("|");
        next if @tabulated.first({ $key.starts-with($_) });
        %alternatives{$key} = $translation;
    }

    my $table := $io.slurp;
    LEAVE $io.spurt($table);     # whatever happens, the table is put back

    # Generate from a table the current L10N can actually read. No padding:
    # read-hash splits the line in two with :skip-empty, so anything trailing
    # would stay glued to the translation.
    $io.spurt: $table.lines.map({
        !.starts-with("#") && .words[1] && .words[1].contains("|")
          ?? .subst(.words[1], .words[1].split("|").head)
          !! $_
    }).join("\n") ~ "\n";

    L10N.update-localization-modules($io);

    my $localization := $io.basename.subst(".$extension");
    my $tokens := "{+%alternatives} token"
      ~ "{"s" unless %alternatives == 1}";

    if $synonyms {
        my $module := "lib/L10N/$localization.rakumod".IO;
        my $source  = $module.slurp;

        for %alternatives.kv -> $key, $translation {
            # the name slangify gives the token
            my $token := $key.trans('^()' => 'cpp');
            my $from  := "token $token \{ {$translation.split('|').head}\}";
            my $to    := "token $token \{ $translation\}";

            die "the generated module has no `$from` to widen"
              unless $source.contains($from);
            $source .= subst($from, $to);
        }
        $module.spurt($source);

        say "$localization: $tokens widened to "
          ~ "{%alternatives.values.map(*.split('|').elems).sum} spellings";
    }
    else {
        say "$localization: rebuilt, $tokens left at the first spelling "
          ~ "(--synonyms for all of them)";
    }

    # Precompile the slang, as update-localization does, to check it works.
    "use lib '.'; use L10N::$localization".EVAL;
}

